<view class="gold-page">
  <view class="gold-title-bar">
    <view class="gold-title">黄金价格提醒</view>
    <button class="share-button" open-type="share" aria-label="分享">
      <text class="share-symbol">↗</text>
    </button>
  </view>

  <view class="gold-content">
    <view class="price-panel">
      <view class="panel-head">
        <view class="eyebrow">实时金价</view>
        <view class="freshness">{{updatedAtText}}</view>
      </view>

      <view wx:if="{{loading}}" class="state-box">正在获取最新价格...</view>
      <view wx:elif="{{error}}" class="state-box error">{{error}}</view>
      <view wx:else>
        <view class="price-row">
          <view class="price-col">
            <view class="price-value">
              <text class="currency">¥</text>
              <text class="price">{{displayPrice}}</text>
            </view>
            <view class="price-label">售价</view>
          </view>
          <view class="price-divider"></view>
          <view class="price-col">
            <view class="price-value">
              <text class="currency buyback-currency">¥</text>
              <text class="price buyback-price">{{displayBuybackPrice}}</text>
            </view>
            <view class="price-label">回收价</view>
          </view>
        </view>
        <view class="unit">人民币/克</view>
      </view>
    </view>

    <view class="chart-panel">
      <view class="chart-head">
        <view class="chart-title">回收价走势</view>
        <view class="today-range">
          <view class="range-item">
            <text class="range-label">今日最高</text>
            <text class="range-value high">¥{{todayHighPrice}}</text>
          </view>
          <view class="range-item">
            <text class="range-label">今日最低</text>
            <text class="range-value low">¥{{todayLowPrice}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{klineLoading}}" class="chart-state">正在生成K线...</view>
      <view wx:elif="{{klineError}}" class="chart-state error">{{klineError}}</view>
      <ec-canvas
        wx:else
        id="kline-chart"
        class="kline-chart"
        canvas-id="kline-chart"
        ec="{{ ec }}"
      ></ec-canvas>
    </view>

    <view class="quick-grid">
      <view class="quick-card" bindtap="goCreateAlert">
        <view class="quick-icon">＋</view>
        <view>
          <view class="quick-title">新增提醒</view>
          <view class="quick-desc">高于或低于目标价时记录提醒</view>
        </view>
      </view>
      <view class="quick-card" bindtap="goHistory">
        <view class="quick-icon">时</view>
        <view>
          <view class="quick-title">提醒历史</view>
          <view class="quick-desc">查看已触发的价格提醒</view>
        </view>
      </view>
    </view>

    <view class="notice">
      仅供个人关注黄金价格变化与记录提醒。
    </view>
  </view>
</view>
